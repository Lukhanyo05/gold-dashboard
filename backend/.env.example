PORT=5000
MONGO_URI=mongodb://localhost:27017/gold-dashboard
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
GOLD_API_KEY=your_key_here
TAX_RATE=0.41
NODE_ENV=development

# --- Production-only ---
# Comma-separated list of exact frontend origins allowed to call this API
# when NODE_ENV=production (the dev localhost allowance does not apply).
# CORS_ORIGINS=https://app.goldholdings.co.za

# Leave unset (or "false") except for the one-time moment you need to
# create the real account — this app has a single shared dataset, so a
# second registered user would see and edit the same real trading data.
# ALLOW_REGISTRATION=true
