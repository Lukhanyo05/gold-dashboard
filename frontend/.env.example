# Dev default matches the backend's local PORT=5000.
VITE_API_URL=http://localhost:5000/api

# --- Production ---
# Set at BUILD TIME to the deployed backend's public URL, e.g.:
# VITE_API_URL=https://api.goldholdings.co.za/api

# Leave unset (or "false") except for the one-time moment you need to
# create the real account — this app has a single shared dataset, so a
# second registered user would see and edit the same real trading data.
# VITE_ALLOW_REGISTRATION=true
